# ============================================================================
# PRODUCTION ENVIRONMENT CONFIGURATION (.env.production)
# Copy this file to .env.production on your Linux VPS before running docker compose
# ============================================================================

# 1. Existing MySQL Database Connection on Server
# - If MySQL is installed directly on the Linux VPS host (or exposed on host port 3306):
#   use MYSQL_HOST=host.docker.internal
# - If MySQL is a Managed Cloud DB or another server IP:
#   use MYSQL_HOST=<your-mysql-server-ip-or-hostname>
MYSQL_HOST=host.docker.internal
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=CHANGE_ME_STRONG_MYSQL_PASSWORD
MYSQL_DATABASE=lawfirm_db

# 2. Security & JWT Authentication
# Generate a random secret on Linux with: openssl rand -hex 32
SECRET_KEY=CHANGE_ME_WITH_64_CHAR_RANDOM_HEX_SECRET_KEY_FOR_PRODUCTION
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 3. Application Port (Accessible at http://<SERVER_IP>:8080)
APP_PORT=8080
APP_EXTERNAL_PORT=8080
