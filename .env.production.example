# ============================================================================
# PRODUCTION ENVIRONMENT CONFIGURATION (.env.production)
# Connects directly to the 'db' (erp-db-1) MySQL container on 'erp_default' network
# ============================================================================

DATABASE_URL=mysql+pymysql://root:password@db:3306/lawfirm_db

MYSQL_HOST=db
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=password
MYSQL_DATABASE=lawfirm_db

# Security & JWT Authentication
SECRET_KEY=vidhi-law-firm-nepal-prod-secret-jwt-key-2083
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Application Port (Accessible at http://<SERVER_IP>:8999)
APP_PORT=8999
APP_EXTERNAL_PORT=8999
